/data/
/datasets/
/artifacts/
/checkpoints/
/outputs/
/runs/
/mlruns/
/wandb/

# Editors and operating-system metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# File summary: Keeps private models, datasets, environments, secrets, caches,
# runtime state, experiment output, and other generated heavy files out of Git.
