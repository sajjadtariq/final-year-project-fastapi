__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Runtime state and logs
runtime/
logs/
*.log
*.pid
*.tmp
*.temp

# All private model payloads and training artifacts; keep only their instructions
models/*
!models/README.md

# Model/checkpoint formats outside models/
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
*.engine
*.tflite
*.h5
*.hdf5
*.keras
*.pb
*.mlmodel
*.joblib

