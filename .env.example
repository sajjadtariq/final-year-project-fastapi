SKINHEALTH_LOAD_MODELS=true
SKINHEALTH_EFFICIENTNET_CHECKPOINT=./models/efficientnet-b3/checkpoints/best.pt
SKINHEALTH_YOLO_CHECKPOINT=./models/yolo11m.pt
SKINHEALTH_DEVICE=auto
SKINHEALTH_CORS_ORIGINS=
INTERNAL_API_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
DOCS_ENABLED=false
SKINHEALTH_MAX_CONCURRENCY=1
SKINHEALTH_MAX_FILE_SIZE_MB=15
SKINHEALTH_YOLO_IMAGE_SIZE=640
SKINHEALTH_YOLO_CONFIDENCE=0.45
SKINHEALTH_YOLO_IOU=0.70
SKINHEALTH_YOLO_MAX_DETECTIONS=20
SKINHEALTH_DETECTOR_VERSION=yolo11m-skin-v1-baseline-aug
SKINHEALTH_PIPELINE_VERSION=local-pipeline-v1
YOLO_CONFIG_DIR=./runtime

